{

  "groups": [
    {
      "key": "system-commands",
      "name": "命令执行",
      "remark": "执行系统命令和脚本，如数据库升级、数据初始化等",
      "task_type": "COMMAND",
      "items": [
        {
          "key": "示例-命令",
          "name": "示例：一条命令",
          "type": "COMMAND",
          "params": {
            "command": "echo hello from scheduler && date /t"
          },
          "schedule": null,
          "timeout_s": 60,
          "enabled": true,
          "description": "示例：echo 一条命令"
        },
        {
          "key": "jiangping",
          "name": "数据降频脚本",
          "type": "COMMAND",
          "params": {
            "command": "python C:/应用文件夹/tools/可视化降频滤波.py"
          },
          "schedule": null,
          "timeout_s": 60,
          "enabled": true,
          "description": "数据降频滤波"
        },
        {
          "key": "shujufenxi",
          "name": "数据分析脚本",
          "type": "COMMAND",
          "params": {
            "command": "C:/Users/bzds/miniforge3/envs/common/python.exe c:/应用文件夹/script_code/RealTimeStiching/src/RTSDHM.py"
          },
          "schedule": null,
          "timeout_s": 60,
          "enabled": true,
          "description": "数据分析画图"
        }
      ]
    },

    {
      "key": "system-scripts",
      "name": "系统脚本",
      "remark": "定时/手动执行 .ps1 / .bat / .py 脚本",
      "task_type": "SCRIPT",
      "items": [
        {
          "key": "示例-脚本",
          "name": "示例：定时脚本",
          "type": "SCRIPT",
          "params": {
            "path": "scripts/hello.ps1"
          },
          "schedule": "*/5 * * * *",
          "enabled": false,
          "description": "示例：每5分钟执行一个 .ps1 脚本（默认关闭）"
        }
      ]
    },

    {
      "key": "applications",
      "name": "应用软件",
      "remark": "点击启动常用软件（PROGRAM + detach 启动即成功）",
      "task_type": "PROGRAM",
      "items": [
        {
          "key": "打开-记事本",
          "name": "打开记事本",
          "type": "PROGRAM",
          "params": {
            "path": "C:\\Windows\\System32\\notepad.exe",
            "detach": true
          },
          "schedule": null,
          "timeout_s": 0,
          "enabled": true,
          "description": "点击启动记事本（detach：启动即成功）"
        }
      ]
    },

    {
      "key": "file-operations",
      "name": "文件操作",
      "remark": "FILEOP 内置动作：删除/复制/移动文件或目录",
      "task_type": "FILEOP",
      "items": [
        {
          "key": "示例-删除文件",
          "name": "示例：删除单个文件",
          "type": "FILEOP",
          "params": {
            "action": "DELETE_FILE",
            "source": "C:\\temp\\scheduler\\demo.txt",
            "recursive": false
          },
          "schedule": null,
          "enabled": false,
          "description": "示例：删除单个文件（FILEOP 内建动作 DELETE_FILE）"
        }
      ]
    }
  ]
}